{
  "name": "@api-hooks/npm",
  "version": "2.4.0",
  "description": "React hooks for the npm registry API, built on @tanstack/react-query",
  "keywords": [
    "react",
    "hooks",
    "npm",
    "registry",
    "react-query",
    "tanstack"
  ],
  "license": "MIT",
  "homepage": "https://github.com/ElJijuna/api-hooks#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ElJijuna/api-hooks.git",
    "directory": "packages/npm"
  },
  "bugs": {
    "url": "https://github.com/ElJijuna/api-hooks/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly --declarationMap",
    "dev": "vite build --watch",
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "docs": "typedoc"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "react": ">=19.0.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.101.0",
    "@testing-library/react": "^16.3.2",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typedoc": "^0.28.19",
    "vite": "^8.0.16",
    "vite-magic-tree-shaking": "^1.0.0"
  },
  "dependencies": {
    "npmjs-api-client": "^1.9.0"
  },
  "author": "pilmee <pilmee@gmail.com> (https://github.com/ElJijuna)"
}

{
  "name": "api-hooks",
  "private": true,
  "version": "0.0.0",
  "description": "A collection of React hooks built on @tanstack/react-query for seamless API integration",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "check": "npm run lint && npm run typecheck",
    "clean": "find . -name 'dist' -not -path '*/node_modules/*' -exec rm -rf {} +"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.8",
    "@swc/core": "^1.15.40",
    "@swc/jest": "^0.2.39",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^10.4.1",
    "semantic-release": "^25.0.3",
    "semantic-release-monorepo": "^8.0.2",
    "super-configs": "^1.11.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "author": "pilmee <pilmee@gmail.com> (https://github.com/ElJijuna)",
  "license": "MIT"
}
